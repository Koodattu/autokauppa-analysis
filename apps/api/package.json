    "@nettiauto/logging": "workspace:*",
    "@nettiauto/schemas": "workspace:*",
    "@sentry/bun": "^10.62.0",
    "hono": "^4.12.27",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
