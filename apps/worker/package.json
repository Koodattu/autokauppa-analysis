{
  "name": "@nettiauto/worker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build && graphile-worker -C graphile.config.mjs",
    "start": "graphile-worker -C graphile.config.mjs",
    "build": "tsc -p tsconfig.json --tsBuildInfoFile dist/tsconfig.tsbuildinfo && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/tasks',{recursive:true});for(const f of ['sharp-encode.mjs','hero-image-encoder.mjs'])fs.copyFileSync('src/'+f,'dist/'+f)\"",
    "probe:transport": "bun run build && bun dist/probe-nettiauto-transport.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@nettiauto/config": "workspace:*",
    "@nettiauto/db": "workspace:*",
    "@nettiauto/domain": "workspace:*",
    "@nettiauto/logging": "workspace:*",
    "@nettiauto/schemas": "workspace:*",
    "graphile-worker": "^0.18.0",
    "impit": "0.14.9",
    "pg": "^8.23.1",
    "sharp": "0.35.5",
    "tough-cookie": "6.1.0",
    "zod": "^4.6.7"
  }
}
