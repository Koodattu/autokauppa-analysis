{
  "name": "@nettiauto/worker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build && graphile-worker -C graphile.config.mjs",
    "start": "graphile-worker -C graphile.config.mjs",
    "build": "tsc -p tsconfig.json --tsBuildInfoFile dist/tsconfig.tsbuildinfo && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/tasks',{recursive:true});fs.copyFileSync('src/sharp-encode.mjs','dist/sharp-encode.mjs')\"",
    "probe:transport": "bun run build && bun dist/probe-nettiauto-transport.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nettiauto/config": "workspace:*",
    "@nettiauto/db": "workspace:*",
    "@nettiauto/domain": "workspace:*",
    "@nettiauto/logging": "workspace:*",
    "@nettiauto/schemas": "workspace:*",
    "graphile-worker": "^0.17.2",
    "impit": "0.14.4",
    "pg": "^8.22.0",
    "sharp": "0.35.3",
    "tough-cookie": "6.0.0",
    "zod": "^4.4.3"
  }
}
