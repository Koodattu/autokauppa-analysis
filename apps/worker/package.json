{
  "name": "@nettiauto/worker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build && graphile-worker --task-directory ./dist/tasks --watch",
    "start": "graphile-worker --task-directory ./dist/tasks",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').mkdirSync('dist/tasks', { recursive: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@nettiauto/config": "workspace:*",
    "@nettiauto/db": "workspace:*",
    "@nettiauto/domain": "workspace:*",
    "@nettiauto/logging": "workspace:*",
    "@nettiauto/schemas": "workspace:*",
    "@sentry/node": "^10.62.0",
    "graphile-worker": "^0.17.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
