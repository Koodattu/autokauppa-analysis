{
  "name": "nettiauto-analytics",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev:worker": "bun --cwd apps/worker dev",
    "build:web": "bun --cwd apps/web build",
    "build:api": "bun --cwd apps/api build",
    "build:worker": "bun --cwd apps/worker build",
    "typecheck:web": "bun --cwd apps/web typecheck",
    "typecheck:api": "bun --cwd apps/api typecheck",
    "typecheck:worker": "bun --cwd apps/worker typecheck",
    "typecheck:packages": "bun --cwd packages/config typecheck && bun --cwd packages/db typecheck && bun --cwd packages/domain typecheck && bun --cwd packages/logging typecheck && bun --cwd packages/schemas typecheck && bun --cwd packages/ui typecheck",
    "test": "vitest run",
    "test:integration": "vitest run packages/domain/src/product.integration.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
