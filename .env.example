APP_ENV=development
NODE_ENV=development

SITE_ADDRESS=:80

POSTGRES_DB=nettiauto_analytics
POSTGRES_USER=nettiauto
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://nettiauto:change-me@postgres:5432/nettiauto_analytics

ALLOW_EMPTY_MIGRATIONS=false

ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
SENTRY_DSN=

CRAWLER_ENABLED=false
CRAWLER_PAUSED=false
CRAWLER_DELAY_MS=2500
CRAWLER_REQUEST_TIMEOUT_MS=30000
# 0 means crawl all source-reported pages for each due source query.
CRAWLER_MAX_PAGES_PER_RUN=2
# Block, challenge, and rate-limit responses pause the source for six hours.
CRAWLER_BLOCK_PAUSE_MS=21600000
# Detail enrichment is separately opt-in and capped per Crawl Run.
CRAWLER_DETAIL_ENABLED=false
CRAWLER_DETAIL_MAX_PER_RUN=50
# Number of missing/v1 detail listings queued by each resumable backfill-control job.
DETAIL_BACKFILL_BATCH_SIZE=200
# One immutable 960px WebP (quality 75) hero per listing, outside PostgreSQL.
HERO_IMAGE_ARCHIVE_ENABLED=true
HERO_IMAGE_STORAGE_PATH=/data/hero-images
HERO_IMAGE_MAX_SOURCE_BYTES=20971520

INTERNAL_API_BASE_URL=http://api:3001
NEXT_PUBLIC_API_BASE_PATH=/api
