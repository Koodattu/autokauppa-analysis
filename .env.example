APP_ENV=development
NODE_ENV=development

SITE_ADDRESS=:80

POSTGRES_DB=nettiauto_analytics
POSTGRES_USER=nettiauto
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://nettiauto:change-me@postgres:5432/nettiauto_analytics

ALLOW_EMPTY_MIGRATIONS=false

ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
SENTRY_DSN=

CRAWLER_ENABLED=false
CRAWLER_PAUSED=false
CRAWLER_DELAY_MS=2500
# Adds 0-1000 ms of random spacing so source requests do not run at a fixed cadence.
CRAWLER_DELAY_JITTER_MS=1000
CRAWLER_REQUEST_TIMEOUT_MS=30000
# 0 means crawl all source-reported pages for each due source query.
CRAWLER_MAX_PAGES_PER_RUN=2
# Block, challenge, and rate-limit responses pause the source for six hours.
CRAWLER_BLOCK_PAUSE_MS=21600000
# Detail enrichment is separately opt-in and capped per Crawl Run.
CRAWLER_DETAIL_ENABLED=false
CRAWLER_DETAIL_MAX_PER_RUN=50
# Source transport: fetch, impit, or flaresolverr. Impit passed bounded local and production probes.
NETTIAUTO_SOURCE_TRANSPORT=impit
# FlareSolverr is internal to Compose; its host port is bound only to loopback for operator probes.
FLARESOLVERR_URL=http://flaresolverr:8191/v1
FLARESOLVERR_PORT=8191
FLARESOLVERR_SESSION_ID=nettiauto-worker
FLARESOLVERR_SESSION_TTL_MINUTES=30
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_MEMORY_LIMIT=1g
FLARESOLVERR_CPUS=1.0
# Maximum number of queued/in-flight detail and hero backfill jobs at one time.
DETAIL_BACKFILL_BATCH_SIZE=200
# Maximum targets in one detail-backfill run. Keep 20 for the canary; set 0 only after audit.
DETAIL_BACKFILL_TARGET_LIMIT=20
# One immutable 960px WebP (quality 75) hero per listing, outside PostgreSQL.
HERO_IMAGE_ARCHIVE_ENABLED=true
HERO_IMAGE_STORAGE_PATH=/data/hero-images
HERO_IMAGE_MAX_SOURCE_BYTES=20971520

INTERNAL_API_BASE_URL=http://api:3001
NEXT_PUBLIC_API_BASE_PATH=/api
